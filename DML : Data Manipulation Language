--DML : Data Manipulation Language 
--it is use to perform query in database to 
--insert,retrive ,  delete , or update something in the database

create table Car(
   c_no int primary key,
   model varchar(15) unique ,
   company varchar(13)
);

insert into Car(c_no,model,company)   --insert it is a DML command 
values(6490 , 'ps' , 'Hero'),
(2123 , 'cliqk' , 'TVS'),
(3432 , 'SAGAR' , 'Royal Enfield'),
(6554 , 'hawnk' , 'Mahindra');

select * from Car;              --select it is also a dml command🤦‍

update Car set model='destni'        -- here update is also present brother 
where c_no=6490;

select * from Car limit 2; -- linit is a constraint we use for specific answer 

update Car set model='thar'
where company='Mahindra';

select * from Car;  


delete from Car        -- delete is also a ddml command use to remove rows 
where model='thar';

update Car set model='hawnk'
where company='Mahindra';
