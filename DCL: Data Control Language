--Basic things are done above now it's time for creating role assigning permission then making user and assigning tham role

create role customer_role;
create role employee_role;
create role manager_role;
--created roles now grant permission 

grant select on customers to customer_role;

grant select on employee to employee_role;
grant select , update on customers to employee_role;
grant select , update , insert on transactions to employee_role; 


grant all PRIVILEGES on customers to manager_role;
grant all PRIVILEGES on employee to manager_role;
grant all PRIVILEGES on transactions to manager_role;

--granted permissions based on roles now 
--all the customers has seprate access using customer_role 
--all the employee has seprate access using employee_role 
-- same for manager role also

--we can also revoke permission . ex . 

revoke all PRIVILEGES on transactions from manager_role;


