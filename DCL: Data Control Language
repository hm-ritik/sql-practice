--DCL : Data Control Language , it is use to give and permission to the user.
--There are usually two commands 
--Grant it is use to give permission , Revoke: use to  remove permission 

---- Industries works usually with RBA system
--RBA: Role Based Access :-giving permission based on Role 
--make  roles then assign permission to the role 
--then create user and give them role which we made . 

--DCL commands are more for 
--Data security
--Role based permission


--Making a DATABSE FOR BANKING SYSTEM END TO END TO UNDERSTAND DCL COMMANDS 
--BANKING SYSTEM DATABASE : MANAGER,EMPLOYEE , CUSTOMER 

create table customers(
    customer_id int primary key , 
    name varchar(15),
    balance float
);

create table employee(
    emp_id int primary key ,
    em_name varchar(20),
    dept varchar(19)
);
create table transactions(
    tran_id int primary key  , 
    customer_id int , 
    amount float , 
    foreign key (customer_id) 
    references customers  (customer_id)
    
);

