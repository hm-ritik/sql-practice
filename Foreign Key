create table student (
 id serial primary key ,
 name varchar(12),
 marks float ,
 dept_id int ,
 foreign key(dept_id)       --________
 references dept(dept_id) --__________/ using foreign key 
 );
 
 -- here is the importent point whenver we insert values in student table 
 -- foreign key set a limit on dept_id range , if user cross the range 
 -- while inserting values in table student will get error. 
 
