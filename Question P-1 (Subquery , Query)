--Find Second Highest salary
select max(salary) from Employee where salary<(
  select max(salary) from Employee
);
select * FROM Employee order by salary desc limit 1 offset 1;  -- i found this one the most optimal 
--There is a edge case here what if to person has highest salary we get wrong answers so , 
select distinct salary    -- distinct removes duplicate rows from result
from Employee;

select distinct salary from Employee order by salary desc limit 1 offset 1;



--Find the name of Employee taking second highest salary
select emp_name from Employee where salary=(
  select max(salary) from Employee where salary<(
    select max(salary) from Employee
  )
);
select * from Employee where salary=(
  select distinct salary from Employee order by salary desc limit 1 offset 1
);

--Find the name of employee taking highest salary

select emp_name from Employee where salary=(
  select max(salary) from Employee
);

--Display dept name along with numbers of employess working there 
select department, count(*) from Employee group by department; --In previous we also studied 
                                                               --that group by is used for grouping same
                                                               --rows that have same Values in specific column

                                                               
--Display the dep name where no of employess are less than 4. 

select department , count(*) from Employee group by department having count(*)<4;   

--display the name of employess working in department count less than 4 

select emp_name from Employee where department in( -- why in not =?
  select department from Employee group by department having count(*)<4 
);


-- display the name of employee who is taking highest salary in department=Hr
select max(salary) from Employee where department='HR';  -- simple for practice 


-- display the name of employee taking highest salary in each department
select emp_name , salary , department from Employee where salary  in(
select  max(salary)  from Employee group by department );

